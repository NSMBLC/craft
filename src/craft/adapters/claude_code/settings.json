{
  "permissions": {
    "allow": [
      "Bash(craft --help)",
      "Bash(craft status:*)",
      "Bash(craft recall:*)",
      "Bash(craft new:*)",
      "Bash(craft validate:*)",
      "Bash(craft lint:*)",
      "Bash(craft lit:*)",
      "Bash(craft review request:*)",
      "Bash(craft review respond:*)",
      "Bash(craft review show:*)",
      "Bash(craft env init:*)",
      "Bash(craft env propose:*)",
      "Bash(craft verdict:*)",
      "Bash(craft finish:*)",
      "Bash(craft explain:*)",
      "Bash(craft attention:*)",
      "Bash(craft verify:*)"
    ],
    "deny": [
      "Edit(./.claude/**)",
      "Edit(./craft.yaml)",
      "Edit(./memory/**)",
      "Edit(./archive/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "craft hook pre-tool-use",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "craft hook pre-tool-use",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "craft hook user-prompt-submit",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "craft hook session-start",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "craft hook stop",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
